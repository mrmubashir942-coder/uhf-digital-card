rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if uploaded file is a valid image under 5MB with safe MIME types
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml|gif)')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }

    // Authentication checks: Only authenticated users with valid token
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Role verification: Admin has full write privileges
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.admin == true
      );
    }

    // Employee photo ownership verification:
    // 1. User must be authenticated
    // 2. Either admin OR the user's custom claim / employeeId matches the resource target
    // 3. Metadata employeeId matches the authenticated employeeId / uid
    function isPhotoOwner(employeeId) {
      return isAuthenticated() && (
        request.auth.uid == employeeId ||
        request.auth.token.employeeId == employeeId
      );
    }

    // Profile photos partitioned by employee ID: /profile-photos/{employeeId}/{fileName}
    match /profile-photos/{employeeId}/{fileName} {
      // 7. Public visitors should be able to READ the images required by active public digital cards
      allow read: if true;

      // 1. Unauthenticated users MUST NOT be able to upload files.
      // 3. Employees must only be able to upload/replace their own profile photo.
      // 4. Employees must NOT be able to modify another employee's profile photo.
      // 6. Only ADMIN users should be able to manage employee profile images on behalf of employees.
      // 8. 5MB max file size.
      // 9. MIME type validation.
      // 10. Do not rely only on filename: verify against authenticated user path & metadata.
      allow write: if isValidImage() && (
        isAdmin() || (
          isPhotoOwner(employeeId) &&
          request.resource.metadata.employeeId == employeeId
        )
      );

      // 2. Unauthenticated users MUST NOT be able to delete files.
      // 3. Employees must only be able to delete their own profile photo.
      // 4. Employees must NOT be able to delete another employee's profile photo.
      // 6. Admin can delete on behalf of employees.
      allow delete: if isAdmin() || isPhotoOwner(employeeId);
    }

    // Company logo branding assets: /company/{fileName}
    match /company/{fileName} {
      // 7. Public visitors can read company logo on public cards
      allow read: if true;

      // 1. Unauthenticated users MUST NOT upload.
      // 5. Only ADMIN users should be able to upload/replace company logo files.
      // 12. Verify user's ADMIN role.
      allow write: if isAdmin() && isValidImage();

      // 2. Unauthenticated users MUST NOT delete.
      // 5. Only ADMIN users should be able to delete company logo files.
      // 12. Verify user's ADMIN role.
      allow delete: if isAdmin();
    }
  }
}
