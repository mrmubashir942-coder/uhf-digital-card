rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'ADMIN' ||
        request.auth.token.admin == true
      );
    }

    // Company Settings: Public can read corporate identity; only admins can edit
    match /company/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users Collection: Private authentication/role mapping
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Employees Collection
    match /employees/{employeeId} {
      // Public digital cards can be read by anyone if active
      allow read: if resource.data.status == 'ACTIVE' || isOwner(resource.data.uid) || isAdmin();
      
      // Admin has full control
      allow create, delete: if isAdmin();
      
      // Updates: Admin can update all fields; Employee can update only allowed personal fields
      allow update: if isAdmin() || (
        isOwner(resource.data.uid) &&
        // Protect security sensitive fields from employee modification
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.uid == resource.data.uid
      );
    }
  }
}
